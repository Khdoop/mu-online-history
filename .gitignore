# build output
dist/
.astro/

# generated content (derived from source.md via scripts/split-source.mjs)
src/content/seasons/
src/data/references.json

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# environment variables
.env
.env.production
.env.local
.env.*.local

# macOS / Windows cruft
.DS_Store
Thumbs.db
desktop.ini

# editor / tooling caches
# .vscode is committed on purpose: it pins the workspace TypeScript and the
# Biome formatter so the editor matches what `npm run check` / `lint` do.
# Only genuinely per-user files are ignored.
.vscode/*.log
.history/
.idea/
*.swp
.cache/
.turbo/
.vercel/
