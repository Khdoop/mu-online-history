---
import GithubIcon from '@/components/GithubIcon.astro';
import Header from '@/components/Header.astro';
import { REPO_URL, SOURCE_REPO_URL } from '@/lib/site';
import '@/styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'A sourced, patch-by-patch timeline of MU Online from the 2001 closed alpha to today.',
} = Astro.props;

const fullTitle = title === 'MU Online History' ? title : `${title} — MU Online History`;

// Absolute URL for this page, used for both the canonical link and og:url.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="MU Online History" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- Background art is painted by `body::after`, so it is not discoverable
         from the markup — preload it or it lands well after first paint. -->
    <link rel="preload" href="/bg.webp" as="image" type="image/webp" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&display=swap"
    />
  </head>
  <!-- Flex column so `main` absorbs the leftover height and the footer stays at
       the bottom of the viewport on short pages. -->
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-ember-500 focus:px-4 focus:py-2 focus:font-medium focus:text-ink-950"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <footer class="mt-24 border-t border-ink-800 bg-ink-900/90">
      <div
        class="page-shell flex max-w-6xl flex-col gap-2 py-8 text-xs leading-relaxed text-ink-400 sm:flex-row sm:items-center sm:justify-between"
      >
        <p>
          Research and sourcing by <a
            href={SOURCE_REPO_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="text-ember-300 underline underline-offset-2">AlighieriDemiurgs/MuHistory</a
          >. MU Online is a trademark of Webzen Inc. — this site is not affiliated with Webzen.
        </p>
        <p class="flex flex-wrap items-center gap-x-4 gap-y-2">
          <span>
            Every claim is cited. See the <a
              href="/references"
              class="text-ember-300 underline underline-offset-2">references</a
            >.
          </span>
          <a
            href={REPO_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-ink-300 transition-colors hover:text-ember-300"
          >
            <GithubIcon class="h-3.5 w-3.5" />
            Source
          </a>
        </p>
      </div>
    </footer>
  </body>
</html>
