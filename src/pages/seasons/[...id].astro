---
import { render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import Citations from '@/components/Citations.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { formatRange, getSeasons, type Season, seasonEraKey, seasonEraSlug } from '@/lib/seasons';

export const getStaticPaths = (async () => {
  const seasons = await getSeasons();

  return seasons.map((season, index) => ({
    params: { id: season.id },
    props: {
      season,
      prev: seasons[index - 1] ?? null,
      next: seasons[index + 1] ?? null,
      // Other releases in the same era, e.g. every `Season 15 Part *`. Only 13
      // of 78 seasons carry patch headings, so this is what the sidebar falls
      // back to rather than standing empty.
      siblings: seasons.filter(
        (other) =>
          other.id !== season.id &&
          seasonEraKey(other.data.title) === seasonEraKey(season.data.title),
      ),
      eraLabel: seasonEraKey(season.data.title),
    },
  }));
}) satisfies GetStaticPaths;

interface Props {
  season: Season;
  prev: Season | null;
  next: Season | null;
  siblings: Season[];
  eraLabel: string;
}

const { season, prev, next, siblings, eraLabel } = Astro.props;
const { Content, headings } = await render(season);

// Only `##` headings exist in generated season bodies — one per patch.
const patches = headings.filter((heading) => heading.depth === 2);
---

<BaseLayout
  title={season.data.title}
  description={`MU Online ${season.data.title} (${season.data.range}): ${season.data.entryCount} documented changes with sources.`}
>
  <article class="page-shell max-w-6xl py-10 sm:py-12">
    <nav aria-label="Breadcrumb" class="mb-6 text-xs text-ink-400">
      <a href="/seasons" class="hover:text-ember-300">Seasons</a>
      <span aria-hidden="true" class="mx-1.5">/</span>
      <span class="text-ink-300">{season.data.title}</span>
    </nav>

    <header class="border-b border-ink-800 pb-6 sm:pb-8">
      <h1 class="font-display text-2xl font-bold leading-tight text-ink-100 sm:text-5xl">
        {season.data.title}
      </h1>
      <p class="mt-3 font-mono text-xs text-ember-400 sm:text-sm">{formatRange(season)}</p>
      <ul class="mt-4 flex flex-wrap gap-x-4 gap-y-1.5 text-xs text-ink-400 sm:mt-5 sm:gap-x-5">
        <li>{season.data.entryCount} changelog entries</li>
        {patches.length > 0 && <li>{patches.length} patches</li>}
        <li>{season.data.citedRefs.length} distinct sources</li>
      </ul>
    </header>

    <div class="mt-10 gap-12 lg:grid lg:grid-cols-[minmax(0,1fr)_16rem]">
      {/* The changelog is the only content block on the site that was not on a
          surface — every card, reference row and nav panel already uses this
          same treatment. It also sits directly over the background art, so an
          opaque fill is what keeps the body text off the moving backdrop. */}
      <div
        class="season-prose min-w-0 rounded-md border border-ink-700 bg-ink-900/70 p-4 sm:p-6 lg:p-8"
      >
        <Content />
      </div>

      {/* Sidebar. Only 13 of 78 seasons carry patch headings, so an empty rail
          is the common case rather than the exception — a "(0)" label would be
          a permanent zero-state on most pages. Instead the patch list appears
          where it exists, and otherwise the slot is given to the sibling
          releases of the same era, which is real navigation. The era link below
          is always present, so the rail is never empty. */}
      <aside class="patch-toc order-first mb-8 lg:order-0 lg:mb-0">
        <div class="lg:sticky lg:top-24">
          {
            patches.length > 0 ? (
                /* Collapsed on phones, where a tall nested scroll area would push
                   the actual content far down the page. Forced open from `lg` up
                   by the `lg:*` rules on `.patch-toc`. */
                <details
                  open
                  class="group rounded border border-ink-800 lg:rounded-none lg:border-0"
                >
                  <summary class="flex cursor-pointer list-none items-center justify-between gap-2 p-3 font-mono text-xs uppercase tracking-wider text-ink-400 lg:cursor-default lg:p-0">
                    <span>Patches in this season ({patches.length})</span>
                    <span
                      class="text-ink-400 transition-transform group-open:rotate-180 lg:hidden"
                      aria-hidden="true"
                    >
                      ▾
                    </span>
                  </summary>
                  <ul class="max-h-[60vh] space-y-1 overflow-y-auto border-t border-ink-800 px-3 pb-3 pt-2 text-xs lg:mt-3 lg:max-h-[70vh] lg:border-l lg:border-t-0 lg:px-0 lg:pb-0 lg:pl-3">
                    {patches.map((patch) => (
                      <li>
                        <a
                          href={`#${patch.slug}`}
                          class="block rounded py-1 text-ink-400 transition-colors hover:text-ember-300"
                        >
                          {patch.text}
                        </a>
                      </li>
                    ))}
                  </ul>
                </details>
            ) : siblings.length > 0 ? (
              <nav
                aria-label={`Other ${eraLabel} releases`}
                class="rounded border border-ink-800 p-3 lg:rounded-none lg:border-0 lg:p-0"
              >
                <p class="font-mono text-xs uppercase tracking-wider text-ink-400">
                  More in {eraLabel}
                </p>
                <ul class="mt-3 space-y-1 border-ink-800 text-xs lg:border-l lg:pl-3">
                  {siblings.map((sibling) => (
                    <li>
                      <a
                        href={`/seasons/${sibling.id}`}
                        class="block rounded py-1 text-ink-400 transition-colors hover:text-ember-300"
                      >
                        {sibling.data.title}
                        <span class="mt-0.5 block font-mono text-[0.68rem] text-ink-400/70">
                          {sibling.data.entryCount} entries
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            ) : null
          }

          {/* Always offered, including on pages that show the patch TOC —
              otherwise those releases have no route to the combined view. */}
          <a
            href={`/seasons/era/${seasonEraSlug(eraLabel)}`}
            class="group/era mt-4 flex items-center gap-1.5 border-t border-ink-800 px-3 pt-3 font-mono text-xs text-ink-400 transition-colors hover:text-ember-300 lg:mt-5 lg:px-0 lg:pt-4"
          >
            <span>All of {eraLabel} on one page</span>
            <span
              aria-hidden="true"
              class="leading-none opacity-0 transition-all group-hover/era:translate-x-0.5 group-hover/era:opacity-100 group-focus-visible/era:translate-x-0.5 group-focus-visible/era:opacity-100"
            >
              →
            </span>
          </a>
        </div>
      </aside>
    </div>

    <nav
      aria-label="Season navigation"
      class="mt-16 grid gap-3 border-t border-ink-800 pt-8 sm:grid-cols-2"
    >
      {
        prev ? (
          <a
            href={`/seasons/${prev.id}`}
            class="group rounded border border-ink-700 bg-ink-900/85 p-4 transition-colors hover:border-ember-500/50"
          >
            <span class="text-xs text-ink-400">← Previous</span>
            <span class="mt-1 block font-display text-sm font-semibold text-ink-100 group-hover:text-ember-300">
              {prev.data.title}
            </span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next && (
          <a
            href={`/seasons/${next.id}`}
            class="group rounded border border-ink-700 bg-ink-900/85 p-4 text-right transition-colors hover:border-ember-500/50 sm:col-start-2"
          >
            <span class="text-xs text-ink-400">Next →</span>
            <span class="mt-1 block font-display text-sm font-semibold text-ink-100 group-hover:text-ember-300">
              {next.data.title}
            </span>
          </a>
        )
      }
    </nav>
  </article>

  <Citations refIds={season.data.citedRefs} />
</BaseLayout>

<script>
  // The patch list renders open so it works without JS and stays open on
  // desktop. On phones it starts collapsed, since it can be 70+ items long.
  const toc = document.querySelector<HTMLDetailsElement>('.patch-toc details');

  if (toc) {
    const wide = window.matchMedia('(min-width: 64rem)');
    let userToggled = false;

    // Once the reader opens or closes it themselves, stop overriding them.
    toc.addEventListener('toggle', () => {
      if (toc.open !== wide.matches) userToggled = true;
    });

    const sync = () => {
      if (!userToggled) toc.open = wide.matches;
    };

    sync();
    wide.addEventListener('change', sync);
  }
</script>
