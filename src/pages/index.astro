---
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  formatRange,
  getSeasons,
  groupEntryCount,
  groupSeasons,
  groupYears,
  isOngoing,
  references,
  seasonEraSlug,
  startYear,
} from '@/lib/seasons';

const seasons = await getSeasons();
const groups = groupSeasons(seasons);

const totalEntries = seasons.reduce((sum, season) => sum + season.data.entryCount, 0);
const firstYear = startYear(seasons[0]!) ?? 2001;
const lastYear = startYear(seasons[seasons.length - 1]!) ?? new Date().getFullYear();

/* Eras carry wildly different weight — Season 0 documents 156 entries over four
   years, most later eras document 11–33. Scaling the marker by raw share of the
   largest would pin all 21 of those to the floor and say nothing; ranking them
   instead spreads the band that actually varies, while Season 0 still lands at
   the top. No hand-picked list of which releases "matter". */
const eraEntries = groups.map(groupEntryCount);
const rankedEntries = [...eraEntries].sort((a, b) => a - b);
const eraWeights = eraEntries.map((entries) =>
  groups.length > 1 ? rankedEntries.indexOf(entries) / (groups.length - 1) : 1,
);

/* Entries documented per calendar year. Charging every entry to the year its
   release *started* is wrong here: Season 0 alone runs 2001–2005, so all 156 of
   its entries would spike on 2001 and flatten the other 24 years into a line.
   Each release spreads its entries evenly across the years it actually spans. */
const perYear = new Map<number, number>();
for (const season of seasons) {
  const from = startYear(season);
  if (from === null) continue;

  const parsedTo = Number.parseInt(season.data.endDate.split('.')[2] ?? '', 10);
  // `…` (ongoing) and unparseable end dates fall back to a single-year release.
  const to = Number.isNaN(parsedTo) ? from : Math.max(from, parsedTo);
  const share = season.data.entryCount / (to - from + 1);

  for (let year = from; year <= to; year += 1) {
    perYear.set(year, (perYear.get(year) ?? 0) + share);
  }
}
const years = Array.from({ length: lastYear - firstYear + 1 }, (_, index) => firstYear + index);
const busiestYear = Math.max(...perYear.values());

const stats = [
  { value: String(seasons.length), label: 'releases tracked' },
  { value: String(totalEntries), label: 'changelog entries' },
  { value: String(references.length), label: 'cited sources' },
  { value: `${lastYear - firstYear}`, label: 'years of history' },
];
---

<BaseLayout title="MU Online History">
  <section class="border-b border-ink-800">
    <div class="page-shell max-w-6xl py-12 sm:py-24">
      <p class="font-mono text-[0.7rem] uppercase tracking-[0.2em] text-ember-400 sm:text-xs sm:tracking-[0.25em]">
        {firstYear} — {lastYear}
      </p>
      <h1
        class="mt-4 max-w-3xl font-display text-[1.9rem] font-bold leading-[1.15] text-ink-100 sm:text-5xl lg:text-6xl"
      >
        Every patch, every season, every source.
      </h1>
      <p class="mt-5 max-w-2xl text-sm leading-relaxed text-ink-300 sm:mt-6 sm:text-lg">
        A complete, cited timeline of MU Online — from the closed alpha in South Korea to the
        current season. Each entry links back to the archived patch note or announcement it came
        from.
      </p>

      <div class="mt-8 flex flex-col gap-2.5 sm:mt-10 sm:flex-row sm:flex-wrap sm:gap-3">
        <a
          href={`/seasons/${seasons[0]!.id}`}
          class="rounded border border-ember-500 bg-ember-500/15 px-5 py-2.5 text-center text-sm font-medium text-ember-300 transition-colors hover:bg-ember-500/25"
        >
          Start at Season 0
        </a>
        <a
          href="/seasons"
          class="rounded border border-ink-700 px-5 py-2.5 text-center text-sm font-medium text-ink-200 transition-colors hover:border-ink-600 hover:bg-ink-850"
        >
          Browse all seasons
        </a>
      </div>

      <dl class="mt-12 grid grid-cols-2 gap-px overflow-hidden rounded border border-ink-800 bg-ink-800 sm:mt-14 sm:grid-cols-4">
        {
          stats.map((stat) => (
            <div class="bg-ink-900 px-3 py-4 sm:px-4 sm:py-5">
              <dt class="text-[0.7rem] uppercase leading-tight tracking-wider text-ink-400 sm:text-xs">
                {stat.label}
              </dt>
              <dd class="mt-1 font-display text-xl font-bold text-ember-300 sm:text-3xl">
                {stat.value}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  {/* The timeline sits on its own surface so the archive reads as a distinct
      half of the page rather than continuing the hero's flat backdrop. */}
  <section class="border-t border-ink-800 bg-ink-900/40">
    <div class="page-shell max-w-6xl py-12 sm:py-16">
      <h2 class="font-display text-xl font-bold text-ink-100 sm:text-2xl">The timeline</h2>
      <p class="mt-2 text-sm text-ink-400">
        Grouped by era. Sub-parts are listed in release order.
      </p>

      {/* Documented change per year. A shape, not a chart: no axis, no values —
          it exists so the shape of the archive is legible before scrolling
          through 22 eras of it. */}
      <figure class="mt-8 rounded border border-ink-800 bg-ink-900/60 p-4 sm:p-5">
        <figcaption class="font-mono text-[0.7rem] uppercase tracking-wider text-ink-400">
          Documented changes per year
        </figcaption>
        <div class="mt-3 flex h-20 items-end gap-px sm:h-24 sm:gap-0.5">
          {
            years.map((year) => {
              // Rounded only for display — the height uses the exact share so
              // neighbouring years of one long release stay level.
              const raw = perYear.get(year) ?? 0;
              const count = Math.round(raw);
              return (
                <div class="group/bar relative flex h-full flex-1 items-end">
                  {/* Baseline keeps empty years visible as part of the run. */}
                  <div
                    class="w-full rounded-[1px] bg-ember-500/35 transition-colors group-hover/bar:bg-ember-400"
                    style={`height: ${raw === 0 ? 2 : Math.max(4, (raw / busiestYear) * 100)}%`}
                  />
                  <span class="sr-only">{`${year}: ${count} entries`}</span>
                  {/* Year tooltip on hover; the axis below only labels every fifth. */}
                  <span
                    aria-hidden="true"
                    class="pointer-events-none absolute -top-1 left-1/2 -translate-x-1/2 -translate-y-full whitespace-nowrap rounded border border-ink-700 bg-ink-950 px-1.5 py-0.5 font-mono text-[0.65rem] text-ink-200 opacity-0 transition-opacity group-hover/bar:opacity-100"
                  >
                    {year} · {count}
                  </span>
                </div>
              );
            })
          }
        </div>
        <div aria-hidden="true" class="mt-2 flex gap-px font-mono text-[0.6rem] text-ink-400 sm:gap-0.5">
          {
            years.map((year, index) => (
              <span class="flex-1 text-center">
                {index % 5 === 0 || index === years.length - 1 ? `'${String(year).slice(2)}` : ''}
              </span>
            ))
          }
        </div>
      </figure>

      {/* `timeline-rail` draws the vertical line and centres each marker on it,
          so the gutter width can change without re-tuning magic offsets. */}
      <ol class="timeline-rail mt-10 space-y-10">
        {
          groups.map((group, index) => {
            const ongoing = group.seasons.some(isOngoing);
            /* Rank among all eras (0–1), floored so the lightest marker is
               still unmistakably a marker rather than a speck. */
            const weight = Math.max(0.3, eraWeights[index]!);

            return (
              <li class="relative">
                <span
                  class:list={['timeline-marker', ongoing && 'timeline-marker-current']}
                  style={`--marker-weight: ${weight.toFixed(3)}`}
                  aria-hidden="true"
                />
                <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                  <h3 class="font-display text-base font-semibold sm:text-lg">
                    <a
                      href={`/seasons/era/${seasonEraSlug(group.label)}`}
                      class="group/era inline-flex items-center gap-1.5 text-ember-300 transition-colors hover:text-ember-400"
                    >
                      {group.label}
                      <span
                        aria-hidden="true"
                        class="text-[0.8em] leading-none opacity-0 transition-all group-hover/era:translate-x-0.5 group-hover/era:opacity-100 group-focus-visible/era:translate-x-0.5 group-focus-visible/era:opacity-100"
                      >
                        →
                      </span>
                      <span class="sr-only">— view combined overview</span>
                    </a>
                  </h3>
                  <span class="font-mono text-xs text-ink-400">{groupYears(group)}</span>
                  {ongoing && (
                    <span class="rounded-full border border-ember-500/60 bg-ember-500/15 px-2 py-0.5 font-mono text-[0.65rem] uppercase tracking-wider text-ember-300">
                      Current
                    </span>
                  )}
                </div>
                <ul class="mt-3 grid gap-2 sm:grid-cols-2">
                  {group.seasons.map((season) => (
                    <li>
                      <a
                        href={`/seasons/${season.id}`}
                        class:list={[
                          'group flex h-full flex-col justify-between rounded border bg-ink-900/85 p-3.5 transition-colors hover:bg-ink-850',
                          isOngoing(season)
                            ? 'border-ember-500/45 hover:border-ember-500/70'
                            : 'border-ink-700 hover:border-ember-500/50',
                        ]}
                      >
                        <span class="text-sm font-medium text-ink-100 group-hover:text-ember-300">
                          {season.data.title}
                        </span>
                        <span class="mt-1.5 font-mono text-xs text-ink-400">
                          {formatRange(season)}
                        </span>
                        <span class="mt-2 text-xs text-ink-400">
                          {season.data.entryCount} entries
                          {season.data.patchCount > 0 && ` · ${season.data.patchCount} patches`}
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            );
          })
        }
      </ol>
    </div>
  </section>
</BaseLayout>
