---
import BaseLayout from '@/layouts/BaseLayout.astro';
import {
  formatRange,
  getSeasons,
  groupSeasons,
  references,
  seasonEraSlug,
  startYear,
} from '@/lib/seasons';

const seasons = await getSeasons();
const groups = groupSeasons(seasons);

const totalEntries = seasons.reduce((sum, season) => sum + season.data.entryCount, 0);
const firstYear = startYear(seasons[0]!) ?? 2001;
const lastYear = startYear(seasons[seasons.length - 1]!) ?? new Date().getFullYear();

const stats = [
  { value: String(seasons.length), label: 'releases tracked' },
  { value: String(totalEntries), label: 'changelog entries' },
  { value: String(references.length), label: 'cited sources' },
  { value: `${lastYear - firstYear}`, label: 'years of history' },
];
---

<BaseLayout title="MU Online History">
  <section class="border-b border-ink-800">
    <div class="page-shell max-w-6xl py-12 sm:py-24">
      <p class="font-mono text-[0.7rem] uppercase tracking-[0.2em] text-ember-400 sm:text-xs sm:tracking-[0.25em]">
        {firstYear} — {lastYear}
      </p>
      <h1
        class="mt-4 max-w-3xl font-display text-[1.9rem] font-bold leading-[1.15] text-ink-100 sm:text-5xl lg:text-6xl"
      >
        Every patch, every season, every source.
      </h1>
      <p class="mt-5 max-w-2xl text-sm leading-relaxed text-ink-300 sm:mt-6 sm:text-lg">
        A complete, cited timeline of MU Online — from the closed alpha in South Korea to the
        current season. Each entry links back to the archived patch note or announcement it came
        from.
      </p>

      <div class="mt-8 flex flex-col gap-2.5 sm:mt-10 sm:flex-row sm:flex-wrap sm:gap-3">
        <a
          href={`/seasons/${seasons[0]!.id}`}
          class="rounded border border-ember-500 bg-ember-500/15 px-5 py-2.5 text-center text-sm font-medium text-ember-300 transition-colors hover:bg-ember-500/25"
        >
          Start at Season 0
        </a>
        <a
          href="/seasons"
          class="rounded border border-ink-700 px-5 py-2.5 text-center text-sm font-medium text-ink-200 transition-colors hover:border-ink-600 hover:bg-ink-850"
        >
          Browse all seasons
        </a>
      </div>

      <dl class="mt-12 grid grid-cols-2 gap-px overflow-hidden rounded border border-ink-800 bg-ink-800 sm:mt-14 sm:grid-cols-4">
        {
          stats.map((stat) => (
            <div class="bg-ink-900 px-3 py-4 sm:px-4 sm:py-5">
              <dt class="text-[0.7rem] uppercase leading-tight tracking-wider text-ink-400 sm:text-xs">
                {stat.label}
              </dt>
              <dd class="mt-1 font-display text-xl font-bold text-ember-300 sm:text-3xl">
                {stat.value}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="page-shell max-w-6xl py-12 sm:py-16">
    <h2 class="font-display text-xl font-bold text-ink-100 sm:text-2xl">The timeline</h2>
    <p class="mt-2 text-sm text-ink-400">
      Grouped by era. Sub-parts are listed in release order.
    </p>

    {/* `timeline-rail` draws the vertical line and centres each marker on it,
        so the gutter width can change without re-tuning magic offsets. */}
    <ol class="timeline-rail mt-10 space-y-10">
      {
        groups.map((group) => (
          <li class="relative">
            <span class="timeline-marker" aria-hidden="true" />
            <h3 class="font-display text-base font-semibold sm:text-lg">
              <a
                href={`/seasons/era/${seasonEraSlug(group.label)}`}
                class="group/era inline-flex items-center gap-1.5 text-ember-300 transition-colors hover:text-ember-400"
              >
                {group.label}
                <span
                  aria-hidden="true"
                  class="text-[0.8em] leading-none opacity-0 transition-all group-hover/era:translate-x-0.5 group-hover/era:opacity-100 group-focus-visible/era:translate-x-0.5 group-focus-visible/era:opacity-100"
                >
                  →
                </span>
                <span class="sr-only">— view combined overview</span>
              </a>
            </h3>
            <ul class="mt-3 grid gap-2 sm:grid-cols-2">
              {group.seasons.map((season) => (
                <li>
                  <a
                    href={`/seasons/${season.id}`}
                    class="group flex h-full flex-col justify-between rounded border border-ink-700 bg-ink-900/85 p-3.5 transition-colors hover:border-ember-500/50 hover:bg-ink-850"
                  >
                    <span class="text-sm font-medium text-ink-100 group-hover:text-ember-300">
                      {season.data.title}
                    </span>
                    <span class="mt-1.5 font-mono text-xs text-ink-400">
                      {formatRange(season)}
                    </span>
                    <span class="mt-2 text-xs text-ink-400">
                      {season.data.entryCount} entries
                      {season.data.patchCount > 0 && ` · ${season.data.patchCount} patches`}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>
  </section>
</BaseLayout>
