{
  // Use the TypeScript installed in this project (6.x) rather than the version
  // bundled with the editor. The bundled one is often newer and reports errors
  // that `npm run check` does not — e.g. failing to resolve
  // `astro/tsconfigs/strict` through the package exports map.
  "js/ts.tsdk.path": "node_modules/typescript/lib",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,

  // Biome owns formatting and linting; see biome.json.
  "editor.defaultFormatter": "biomejs.biome",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.biome": "explicit",
    "source.organizeImports.biome": "explicit"
  },

  "[astro]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[css]": {
    "editor.defaultFormatter": "biomejs.biome"
  },

  // Generated by scripts/split-source.mjs on every build — never edit by hand.
  "files.readonlyInclude": {
    "src/content/seasons/**": true,
    "src/data/references.json": true
  },

  "files.exclude": {
    "**/.astro": true,
    "**/dist": true
  }
}
